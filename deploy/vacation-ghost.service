[Unit]
Description=Vacation Ghost local occupancy routine
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=exec
WorkingDirectory=/opt/vacation-ghost
ExecStart=/opt/vacation-ghost/.venv/bin/python -m vacation_ghost --config /etc/vacation-ghost/vacation.toml run --state-dir /var/lib/vacation-ghost/current
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
KillMode=mixed
TimeoutStopSec=90s
StateDirectory=vacation-ghost
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
